/**
 * Generate src/content/generated.ts with static requires for protocol JSON and page images
 * (Metro bundles only statically-required assets).
 *
 *   node scripts/build-content-index.mts      (from app/)
 */
import { readdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const app = join(dirname(fileURLToPath(import.meta.url)), '..');
const protocols = readdirSync(join(app, 'content', 'protocols'))
  .filter((f) => /^\d{4}\.json$/.test(f))
  .sort();
const pages = readdirSync(join(app, 'assets', 'pages'))
  .filter((f) => /^\d{3}\.webp$/.test(f))
  .sort();

const out = `// AUTO-GENERATED by scripts/build-content-index.mts — do not edit.

export const PROTOCOL_DATA: Record<string, unknown> = {
${protocols.map((f) => `  '${f.slice(0, 4)}': require('../../content/protocols/${f}'),`).join('\n')}
};

export const PAGE_IMAGES: Record<number, number> = {
${pages.map((f) => `  ${Number(f.slice(0, 3))}: require('../../assets/pages/${f}'),`).join('\n')}
};
`;
writeFileSync(join(app, 'src', 'content', 'generated.ts'), out);
console.log(`generated.ts: ${protocols.length} protocols, ${pages.length} page images`);
